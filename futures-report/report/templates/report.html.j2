<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.title }} {{ v.date }}</title>
<style>
  :root {
    --bg: #0d1424;
    --card: #131c2e;
    --card-edge: #22304a;
    --ink: #e6ebf5;
    --ink-2: #9aa7bf;
    --ink-3: #66748f;
    --up: #ef4b4b;      /* 漲／多 */
    --down: #22c55e;    /* 跌／空 */
    --gold: #f2c94c;
    --accent: #ff7a1a;
    --accent-2: #3aa0ff;
    --mono: "JetBrains Mono", "SF Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: radial-gradient(1200px 500px at 50% -10%, #1a2540 0%, var(--bg) 60%) var(--bg);
    color: var(--ink);
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", "WenQuanYi Zen Hei", sans-serif;
  }
  .page { width: 1408px; margin: 0 auto; padding: 28px 18px 24px; }
  header { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 18px 0 30px; }
  header h1 { margin: 0; font-size: 40px; letter-spacing: 2px; font-weight: 800; }
  header h1 .a { color: var(--accent); }
  header h1 .b { color: var(--accent-2); }
  .pill {
    background: #070b14; border: 1px solid var(--card-edge); border-radius: 999px;
    padding: 6px 22px; font-size: 17px; font-weight: 700; letter-spacing: 2px;
  }
  .pill .sep { color: var(--gold); margin: 0 10px; }
  .grid { display: grid; gap: 10px; margin-bottom: 10px; }
  .r1 { grid-template-columns: repeat(3, 1fr); }
  .r2 { grid-template-columns: 1fr 1fr; }
  .r3 { grid-template-columns: 302px 236px 1fr 1fr; }
  .r4 { grid-template-columns: 452px 1fr 1fr; }
  .card {
    background: var(--card); border: 1px solid var(--card-edge); border-radius: 10px;
    padding: 14px 18px; min-width: 0;
  }
  .card h2 { margin: 0 0 10px; font-size: 17px; font-weight: 700; color: var(--ink-2); }
  .card h2.c { text-align: center; color: var(--ink); }
  .head { display: flex; justify-content: space-between; align-items: baseline; }
  .head .big { font-family: var(--mono); font-size: 21px; font-weight: 700; }
  .kpi { text-align: center; padding: 18px 0 14px; }
  .kpi .label { color: var(--ink-2); font-size: 17px; }
  .kpi .value { font-family: var(--mono); font-size: 30px; font-weight: 700; margin: 8px 0 6px; }
  .kpi .delta { font-family: var(--mono); font-size: 16px; }
  .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--ink); }
  table { width: 100%; border-collapse: collapse; font-size: 16px; }
  th { color: var(--ink-3); font-weight: 400; padding: 6px 4px; text-align: right; }
  td { padding: 7px 4px; text-align: right; font-family: var(--mono); }
  th:first-child, td:first-child { text-align: left; font-family: inherit; color: var(--ink); }
  .gauge { height: 160px; }
  .chart { height: 170px; }
  .chart.tall { height: 160px; }
  footer {
    margin-top: 34px; padding-top: 16px; border-top: 1px solid var(--card-edge);
    text-align: center; color: var(--ink-3); font-size: 12px;
  }
</style>
</head>
<body>
<div class="page">
  <header>
    <h1><span class="a">{{ v.title }}</span></h1>
    <div class="pill">盤後籌碼日報<span class="sep">|</span>{{ v.date }}</div>
  </header>

  <section class="grid r1">
    {% for label, k, digits in [("加權指數", v.taiex, 2), ("台指期", v.tx, 2), ("VIX 恐慌指數", v.vix, 2)] %}
    {% set t = k.change|tone %}
    <div class="card kpi">
      <div class="label">{{ label }}</div>
      <div class="value {{ t if label != 'VIX 恐慌指數' else 'flat' }}">{{ k.value|num(digits) }}</div>
      <div class="delta {{ t if label != 'VIX 恐慌指數' else 'flat' }}">
        {% if t == 'up' %}▲{% elif t == 'down' %}▼{% endif %}
        {{ k.change|num(2) }} ({{ k.pct|pct(2) }})
      </div>
    </div>
    {% endfor %}
  </section>

  <section class="grid r2">
    <div class="card"><h2 class="c">當日溫度計</h2><div class="gauge" id="g-day"></div></div>
    <div class="card"><h2 class="c">當周溫度計</h2><div class="gauge" id="g-week"></div></div>
  </section>

  <section class="grid r3">
    <div class="card">
      <h2>期貨籌碼 (口)</h2>
      <table>
        <tr><th>法人</th><th>交易</th><th>未平倉</th><th>增減</th></tr>
        {% for r in v.inst_rows %}
        <tr><td>{{ r.label }}</td>
          <td class="{{ r.trade|tone }}">{{ r.trade|int }}</td>
          <td class="{{ r.oi|tone }}">{{ r.oi|int }}</td>
          <td class="{{ r.delta|tone }}">{{ r.delta|int }}</td></tr>
        {% endfor %}
      </table>
    </div>
    <div class="card">
      <h2>大額交易人</h2>
      <table>
        <tr><th>類別</th><th>淨額</th></tr>
        {% for r in v.big %}
        <tr><td>{{ r.label }}</td><td class="{{ r.value|tone }}">{{ r.value|int }}</td></tr>
        {% endfor %}
      </table>
    </div>
    <div class="card">
      <div class="head"><h2>九大交易人</h2><span class="big {{ v.nine_today|tone }}">{{ v.nine_today|int }}</span></div>
      <div class="chart" id="c-nine"></div>
    </div>
    <div class="card">
      <div class="head"><h2>外資期貨</h2><span class="big {{ v.foreign_today|tone }}">{{ v.foreign_today|int }}</span></div>
      <div class="chart" id="c-foreign"></div>
    </div>
  </section>

  <section class="grid r4">
    <div class="card">
      <h2>散戶期貨籌碼</h2>
      <table>
        <tr><th>商品</th><th>淨未平倉</th><th>增減</th><th>多空比</th></tr>
        {% for r in v.retail_rows %}
        <tr><td>{{ r.label }}</td>
          <td class="{{ r.net|tone }}">{{ r.net|int }}</td>
          <td class="{{ r.delta|tone }}">{{ r.delta|int }}</td>
          <td class="{{ r.ratio|tone }}">{{ r.ratio|pct }}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% for id, label, r in [("c-mxf", "小台散戶", v.retail_rows[0]), ("c-tmf", "微台散戶", v.retail_rows[1])] %}
    <div class="card">
      <div class="head"><h2>{{ label }}</h2><span class="big {{ r.ratio|tone }}">{{ r.ratio|pct }}</span></div>
      <div class="chart tall" id="{{ id }}"></div>
    </div>
    {% endfor %}
  </section>

  <footer>投資風險聲明：本報表所提供之所有資訊僅供參考，不構成任何投資建議。投資人應獨立判斷，審慎評估並自負投資風險及損益。</footer>
</div>

<script>{{ echarts_js|safe }}</script>
<script>
(function () {
  const css = getComputedStyle(document.documentElement);
  const C = (n) => css.getPropertyValue(n).trim();
  const UP = C('--up'), DOWN = C('--down'), GOLD = C('--gold');
  const INK2 = C('--ink-2'), INK3 = C('--ink-3'), EDGE = C('--card-edge');
  const MONO = C('--mono');
  const data = {{ chart_json|safe }};
  const tempDay = {{ v.temp_day if v.temp_day is not none else 'null' }};
  const tempWeek = {{ v.temp_week if v.temp_week is not none else 'null' }};

  // 多空溫度計：左紅（多）右綠（空），外圈為冷熱色帶
  function gauge(id, bull) {
    const el = echarts.init(document.getElementById(id), null, { renderer: 'canvas' });
    if (bull === null) { el.setOption({ title: { text: '資料不足', left: 'center', top: 'middle', textStyle: { color: INK3, fontSize: 14 } } }); return el; }
    const b = Math.round(bull * 100), s = 100 - b;
    const w = el.getWidth(), h = el.getHeight();
    const cx = w / 2, cy = h * 0.94, outer = 122, inner = 44, mid = (outer + inner) / 2;
    const ring = (radius, width, color) => ({
      type: 'gauge', startAngle: 180, endAngle: 0, center: [cx, cy], radius, silent: true,
      axisLine: { lineStyle: { width, color } },
      pointer: { show: false }, axisTick: { show: false }, splitLine: { show: false }, axisLabel: { show: false }, detail: { show: false },
    });
    // 標籤放在各區塊的角度中點
    const text = (pct, fromDeg) => {
      const rad = (fromDeg - pct * 0.9) * Math.PI / 180;
      return { type: 'text', z: 100, x: cx + mid * Math.cos(rad), y: cy - mid * Math.sin(rad),
        style: { text: pct + '%', fill: '#fff', font: '700 15px ' + MONO, align: 'center', verticalAlign: 'middle' } };
    };
    el.setOption({
      series: [
        ring(outer + 10, 8, [[0.3, '#1f8f4e'], [0.7, '#b58a1a'], [1, '#b8323a']]),
        ring(outer, outer - inner, [[b / 100, UP], [1, DOWN]]),
      ],
      graphic: [text(b, 180), text(s, 180 - b * 1.8)],
    });
    return el;
  }

  // 柱狀（籌碼）＋折線（加權指數）的組合圖，沿用原版日報的版型
  function combo(id, values, unit) {
    const el = echarts.init(document.getElementById(id), null, { renderer: 'canvas' });
    const axisCommon = { axisLabel: { color: INK3, fontSize: 9, fontFamily: MONO }, splitLine: { lineStyle: { color: EDGE, opacity: 0.5 } } };
    el.setOption({
      animation: false,
      grid: { left: 46, right: 50, top: 10, bottom: 34 },
      tooltip: {
        trigger: 'axis', axisPointer: { type: 'line', lineStyle: { color: INK3 } },
        backgroundColor: '#0b111d', borderColor: EDGE, textStyle: { color: C('--ink'), fontSize: 12 },
        valueFormatter: (v) => v === null || v === undefined ? '—' : v.toLocaleString(),
      },
      xAxis: { type: 'category', data: data.dates, axisTick: { show: false },
        axisLine: { lineStyle: { color: EDGE } },
        axisLabel: { color: INK3, fontSize: 9, rotate: 18, interval: 7, fontFamily: MONO } },
      yAxis: [
        { type: 'value', ...axisCommon, axisLabel: { ...axisCommon.axisLabel, formatter: (v) => v.toLocaleString() + (unit || '') } },
        { type: 'value', scale: true, ...axisCommon, splitLine: { show: false },
          axisLabel: { ...axisCommon.axisLabel, color: GOLD, formatter: (v) => v.toLocaleString() } },
      ],
      series: [
        { name: '籌碼', type: 'bar', barWidth: '55%', data: values.map((v) => ({ value: v,
            itemStyle: { color: v >= 0 ? UP : DOWN, borderRadius: v >= 0 ? [2, 2, 0, 0] : [0, 0, 2, 2] } })) },
        { name: '加權指數', type: 'line', yAxisIndex: 1, data: data.index, symbol: 'none', smooth: true,
          lineStyle: { color: GOLD, width: 1.5 } },
      ],
    });
    return el;
  }

  gauge('g-day', tempDay);
  gauge('g-week', tempWeek);
  combo('c-nine', data.nine);
  combo('c-foreign', data.foreign);
  combo('c-mxf', data.mxf, '%');
  combo('c-tmf', data.tmf, '%');
  window.__reportReady = true;
})();
</script>
</body>
</html>
